{
  "model_type": "gemma",
  "architectures": [
    "GemmaForCausalLM"
  ],
  "vocab_size": 256000,
  "hidden_size": 2048,
  "intermediate_size": 16384,
  "num_hidden_layers": 18,
  "num_attention_heads": 8,
  "num_key_value_heads": 1,
  "hidden_act": "gelu",
  "max_position_embeddings": 8192,
  "initializer_range": 0.02,
  "rms_norm_eps": 1e-06,
  "use_cache": true,
  "rope_theta": 10000.0,
  "torch_dtype": "float16",
  "transformers_version": "4.36.0",
  "executor_torch_optimized": true,
  "qualcomm_npu_ready": true,
  "qnn_backend": "htp",
  "head_dim": 256,
  "num_experts": 1,
  "num_experts_per_tok": 1,
  "bos_token_id": 2,
  "eos_token_id": 1,
  "pad_token_id": 0,
  "unk_token_id": 3
}