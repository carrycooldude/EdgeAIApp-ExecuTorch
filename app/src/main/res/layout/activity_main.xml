<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ExecuTorch CLIP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visual Question Answering"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <!-- Image Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="2dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">
            
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="fitCenter"
                android:background="#EEEEEE"
                android:contentDescription="Image for analysis" />
        </LinearLayout>
        
        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/captureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 Camera"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/galleryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖼️ Gallery"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Question Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Question (Optional)"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/textInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:hint="e.g., 'Is this a cat?'"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:minLines="1" />

        <!-- Run Button -->
        <Button
            android:id="@+id/inferenceButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="✨ Analyze Similarity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#6200EE"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:elevation="4dp" />

        <!-- Result Area -->
        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready for inference..."
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:padding="16dp"
            android:background="#E0E0E0"
            android:textColor="#333333" />

    </LinearLayout>

</ScrollView>